# =============================================================================
# Azure Speech — local book preparation only
# =============================================================================

# Speech resource key, obtained from Azure Portal > Speech > Keys and Endpoint.
# Required for synthesis · secret · string
AZURE_SPEECH_KEY=

# Region of the same Speech resource, for example brazilsouth or eastus.
# Required for synthesis · string
AZURE_SPEECH_REGION=

# Price per one million characters for your selected voice tier and currency.
# Optional · positive number; used for estimates only · default: unset
# AZURE_SPEECH_PRICE_PER_MILLION=15


# =============================================================================
# Azure Translator — local editorial translation only
# =============================================================================

# Translator resource key from Azure Portal > Keys and Endpoint.
# Required for translation · secret · string
AZURE_TRANSLATOR_KEY=

# Region shown on your Translator resource; leave empty only for a global resource.
# Optional · string · default: empty
AZURE_TRANSLATOR_REGION=

# Text translation endpoint from Azure Portal; the default is the global endpoint.
# Optional · HTTPS URL · default: https://api.cognitive.microsofttranslator.com
# AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
